{
  "name": "timer-tv-webos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audio:copy": "node scripts/copy-audio.mjs",
    "dev": "npm run audio:copy && vite",
    "test": "vitest run",
    "build": "npm run audio:copy && vite build && node scripts/postbuild.mjs && node scripts/check-compat.mjs",
    "tv:package": "ares-package dist --no-minify -o build",
    "tv:install": "npm run build && npm run tv:package && ares-install --device tv build/com.timerapp.tv_0.2.0_all.ipk && ares-launch --device tv com.timerapp.tv",
    "tv:inspect": "ares-inspect --device tv --app com.timerapp.tv --open"
  },
  "dependencies": {
    "preact": "^10.19.2"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.0.0",
    "@preact/preset-vite": "^2.8.1",
    "@vitejs/plugin-legacy": "^5.4.0",
    "@webos-tools/cli": "^3.0.0",
    "autoprefixer": "^10.4.0",
    "es-check": "^7.2.0",
    "sass": "^1.89.2",
    "terser": "^5.30.0",
    "vite": "^5.0.8",
    "vitest": "^4.1.3"
  }
}
